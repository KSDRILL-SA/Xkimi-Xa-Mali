**The pattern for every server component page:**

```typescript
// Standard page pattern
import { auth } from '@/lib/auth'
import { redirect } from 'next/navigation'
import { SomeView } from '@/components/feature/SomeView'
import { getSomeData } from '@/services/some.service'

export default async function SomePage() {
  const session = await auth()
  if (!session) redirect('/auth/login')

  const data = await getSomeData(
    session.user.id,        // who is requesting
    session.user.id,        // whose data
    session.user.roles,     // for RBAC checks inside service
  )

  return <SomeView data={data} userId={session.user.id} />
}
```

**The pattern for every client component form submission:**

```typescript
// Standard form submission pattern
'use client'
import { useState, useTransition } from 'react'
import { useRouter } from 'next/navigation'

export function SomeForm({ ... }) {
  const router = useRouter()
  const [isPending, startTransition] = useTransition()
  const [error, setError] = useState<string | null>(null)

  async function handleSubmit(formData: SomeInput) {
    setError(null)
    const res = await fetch('/api/v1/endpoint', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(formData),
    })
    const json = await res.json()
    if (!res.ok) {
      setError(json.error?.message ?? 'Something went wrong')
      return
    }
    startTransition(() => router.refresh())  // re-run server component
  }

  return (
    <form>
      {error && <Alert variant="error">{error}</Alert>}
      {/* fields */}
      <Button loading={isPending}>Submit</Button>
    </form>
  )
}
```


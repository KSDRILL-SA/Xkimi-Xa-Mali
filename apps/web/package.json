{
  "name": "@xxm/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "render:statement": "tsx --tsconfig scripts/tsconfig.json scripts/render-statement.ts",
    "render:guide": "tsx --tsconfig scripts/tsconfig.json scripts/render-guide.ts",
    "render:handbook": "tsx --tsconfig scripts/tsconfig.json scripts/render-handbook.ts",
    "render:logo": "node scripts/render-brand-png.mjs",
    "render:email": "node --env-file-if-exists=.env.local --import tsx scripts/render-email-preview.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^6.1.0",
    "@react-pdf/renderer": "^4.1.6",
    "@sentry/nextjs": "^10.67.0",
    "@t3-oss/env-nextjs": "^0.10.1",
    "@upstash/ratelimit": "^2.0.4",
    "@upstash/redis": "^1.34.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.6.1",
    "@xxm/config": "*",
    "@xxm/database": "*",
    "@xxm/observability": "*",
    "@xxm/types": "*",
    "@xxm/ui": "*",
    "@xxm/utils": "*",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "decimal.js": "^10.4.3",
    "geist": "^1.7.1",
    "inngest": "^3.29.0",
    "lucide-react": "^0.474.0",
    "next": "^16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "resend": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}

### New Repository

```typescript
// apps/web/repositories/signature.repository.ts
export const signatureRepo = {
  findByAdmin:     (adminId) => db.adminSignature.findUnique({ where: { adminId } }),
  create:          (data) => db.adminSignature.create({ data }),
  update:          (adminId, data) => db.adminSignature.update({ where: { adminId }, data }),
  createHistory:   (data) => db.adminSignatureHistory.create({ data }),
  findHistory:     (adminId) => db.adminSignatureHistory.findMany({
    where: { adminId }, orderBy: { replacedAt: 'desc' }
  }),
}

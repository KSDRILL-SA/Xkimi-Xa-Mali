generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum RoleName {
  ADMIN
  MEMBER
}

enum AccountType {
  SAVINGS
  CHEQUE
  TRANSMISSION
}

enum MandateStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum ContributionStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  WAIVED
}

enum TransactionType {
  DEBIT_ORDER
  MANUAL
  REVERSAL
  SCHEDULED
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

enum GoalType {
  MONTHLY
  YEARLY
  CUSTOM
}

enum GoalStatus {
  DRAFT
  ACTIVE
  ACHIEVED
  FAILED
}

enum NotifChannel {
  SMS
  EMAIL
  PUSH
  WHATSAPP
}

enum NotifStatus {
  QUEUED
  SENT
  FAILED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum BadgeTier {
  AMATEUR
  SEMI_PRO
  PRO
  WORLD_CLASS
}

enum BudgetType {
  MONTHLY
  YEARLY
  CUSTOM
}

// ─── Identity ─────────────────────────────────────────────────────────────────

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  phone           String     @unique
  firstName       String
  lastName        String
  idNumber        String?
  address         Json?
  password        String?
  emailVerified   DateTime?
  image           String?
  status          UserStatus @default(PENDING)
  popiaConsentAt  DateTime?
  loginAttempts   Int        @default(0)
  lockedUntil     DateTime?
  roleVersion     Int        @default(0)
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  roles                  UserRole[]
  accounts               Account[]
  sessions               Session[]
  bankAccounts           BankAccount[]
  mandates               PaymentMandate[]
  contributions          Contribution[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  auditLogs              AuditLog[]
  loginHistory           LoginHistory[]
  lockedGoals            Goal[]                  @relation("GoalLocker")
  createdGoals           Goal[]                  @relation("GoalCreator")
  recordedProgress       GoalProgress[]          @relation("ProgressRecorder")
  passwordResetTokens    PasswordResetToken[]
  emailVerifTokens       EmailVerificationToken[]
  invitesSent            Invitation[]            @relation("InvitesSent")
  inviteAccepted         Invitation?             @relation("InviteAccepted")
  approvedMandates       PaymentMandate[]        @relation("MandateApprover")
  revokedInvitations     Invitation[]            @relation("InviteRevoker")
  badgeScore             BadgeScore?
  badgeHistory           BadgeHistory[]
  communityMessages      CommunityMessage[]      @relation("MessageAuthor")
  deletedCommunityMsgs   CommunityMessage[]      @relation("MessageDeleter")
  budgets                UserBudget[]
  budgetOverrides        BudgetOverride[]
  signature              AdminSignature?
  signatureHistory       AdminSignatureHistory[]

  @@index([status])
  @@index([email, status])
  @@index([deletedAt])
  @@map("users")
}

// ─── NextAuth required models ─────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Auth tokens ──────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model Role {
  id    String   @id @default(cuid())
  name  RoleName @unique
  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ─── Banking ──────────────────────────────────────────────────────────────────

model BankAccount {
  id            String      @id @default(cuid())
  userId        String
  bankName      String
  accountNumber String
  accountType   AccountType
  branchCode    String
  isPrimary     Boolean     @default(false)
  verifiedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  mandates PaymentMandate[]

  @@index([userId])
  @@index([userId, isPrimary])
  @@map("bank_accounts")
}

model PaymentMandate {
  id               String        @id @default(cuid())
  userId           String
  bankAccountId    String
  debitDay         Int
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("ZAR")
  status           MandateStatus @default(PENDING)
  netcashMandateId String?       @unique
  delayedUntil     DateTime?
  failureReason    String?
  approvedAt       DateTime?
  approvedById     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  bankAccount  BankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  approvedBy   User?         @relation("MandateApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId])
  @@index([userId, status])
  @@index([bankAccountId])
  @@index([status])
  @@index([delayedUntil])
  @@map("payment_mandates")
}

// ─── Contributions & Transactions ─────────────────────────────────────────────

model Contribution {
  id          String             @id @default(cuid())
  userId      String
  periodMonth Int
  periodYear  Int
  amountDue   Decimal            @db.Decimal(12, 2)
  amountPaid  Decimal            @default(0) @db.Decimal(12, 2)
  currency    String             @default("ZAR")
  dueDate     DateTime
  status      ContributionStatus @default(PENDING)
  version     Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@unique([userId, periodMonth, periodYear])
  @@index([userId])
  @@index([userId, status])
  @@index([periodYear, periodMonth])
  @@index([status, dueDate])
  @@index([status, periodYear, periodMonth])
  @@index([userId, createdAt])
  @@map("contributions")
}

model Transaction {
  id              String            @id @default(cuid())
  contributionId  String
  mandateId       String
  amount          Decimal           @db.Decimal(12, 2)
  currency        String            @default("ZAR")
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  gatewayRef      String?
  gatewayResponse Json?
  idempotencyKey  String            @unique
  retryCount      Int               @default(0)
  failureReason   String?
  reversalOfId    String?           @unique
  processedAt     DateTime?
  createdAt       DateTime          @default(now())

  contribution Contribution   @relation(fields: [contributionId], references: [id], onDelete: Restrict)
  mandate      PaymentMandate @relation(fields: [mandateId], references: [id], onDelete: Restrict)
  reversalOf   Transaction?   @relation("TransactionReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversal     Transaction?   @relation("TransactionReversal")

  @@index([contributionId])
  @@index([contributionId, status])
  @@index([mandateId])
  @@index([status, createdAt])
  @@index([gatewayRef])
  @@index([type])
  @@index([status, retryCount])
  @@index([createdAt])
  @@map("transactions")
}

// ─── Goals ────────────────────────────────────────────────────────────────────

model Goal {
  id            String     @id @default(cuid())
  type          GoalType
  title         String
  description   String?
  targetAmount  Decimal    @db.Decimal(12, 2)
  currentAmount Decimal    @default(0) @db.Decimal(12, 2)
  currency      String     @default("ZAR")
  deadline      DateTime
  status        GoalStatus @default(DRAFT)
  version       Int        @default(0)
  lockedAt      DateTime?
  lockedById    String?
  createdById   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  locker   User?          @relation("GoalLocker", fields: [lockedById], references: [id], onDelete: SetNull)
  creator  User?          @relation("GoalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  progress GoalProgress[]

  @@index([lockedById])
  @@index([createdById])
  @@index([status])
  @@index([status, deadline])
  @@map("goals")
}

model GoalProgress {
  id           String   @id @default(cuid())
  goalId       String
  amount       Decimal  @db.Decimal(12, 2)
  note         String?
  recordedById String?
  recordedAt   DateTime @default(now())

  goal       Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  recordedBy User? @relation("ProgressRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([goalId])
  @@index([goalId, recordedAt])
  @@map("goal_progress")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model NotificationTemplate {
  id      String       @id @default(cuid())
  slug    String       @unique
  channel NotifChannel
  subject String?
  body    String

  notifications Notification[]

  @@index([channel])
  @@map("notification_templates")
}

model Notification {
  id           String       @id @default(cuid())
  userId       String
  templateId   String
  channel      NotifChannel
  status       NotifStatus  @default(QUEUED)
  payload      Json
  retryCount   Int          @default(0)
  errorMessage String?
  externalRef  String?
  sentAt       DateTime?
  createdAt    DateTime     @default(now())

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  template NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([templateId])
  @@index([status])
  @@index([channel])
  @@index([status, createdAt])
  @@index([externalRef])
  @@map("notifications")
}

model NotificationPreference {
  id       String  @id @default(cuid())
  userId   String  @unique
  sms      Boolean @default(true)
  email    Boolean @default(true)
  push     Boolean @default(true)
  whatsapp Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ─── Audit ────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  payload   Json
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Invitations ─────────────────────────────────────────────────────────────

model Invitation {
  id            String           @id @default(cuid())
  codeHash      String           @unique
  codePrefix    String
  firstName     String
  lastName      String
  email         String
  phone         String
  minimumAmount Decimal          @db.Decimal(12, 2)
  currency      String           @default("ZAR")
  status        InvitationStatus @default(PENDING)
  invitedById   String
  acceptedById  String?          @unique
  revokedById   String?
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime         @default(now())

  invitedBy  User  @relation("InvitesSent",    fields: [invitedById],  references: [id], onDelete: Restrict)
  acceptedBy User? @relation("InviteAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedBy  User? @relation("InviteRevoker",  fields: [revokedById],  references: [id], onDelete: SetNull)

  @@index([invitedById])
  @@index([email])
  @@index([status])
  @@index([status, expiresAt])
  @@map("invitations")
}

// ─── Login history ────────────────────────────────────────────────────────────

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  ipAddress String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, success])
  @@map("login_history")
}

// ─── System configuration ─────────────────────────────────────────────────────

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("system_config")
}

// ─── Badges & Community ────────────────────────────────────────────────────────

model BadgeScore {
  id                String     @id @default(cuid())
  userId            String     @unique
  currentBadge      BadgeTier  @default(AMATEUR)
  overallScore      Decimal    @default(0) @db.Decimal(6, 3)
  consistencyScore  Decimal    @default(0) @db.Decimal(6, 3)
  timelinessScore   Decimal    @default(0) @db.Decimal(6, 3)
  generosityScore   Decimal    @default(0) @db.Decimal(6, 3)
  streakBonus       Decimal    @default(0) @db.Decimal(6, 3)
  progressToNext    Decimal    @default(0) @db.Decimal(6, 3)
  currentStreak     Int        @default(0)
  longestStreak     Int        @default(0)
  totalPaidMonths   Int        @default(0)
  totalOnTimeMonths Int        @default(0)
  totalOverdue      Int        @default(0)
  overdueInLast6    Int        @default(0)
  monthsActive      Int        @default(0)
  avgContribution   Decimal    @default(0) @db.Decimal(10, 2)
  graceUntil        DateTime?
  lastCalculatedAt  DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([currentBadge])
  @@index([overallScore])
  @@map("badge_scores")
}

model BadgeHistory {
  id        String     @id @default(cuid())
  userId    String
  fromBadge BadgeTier?
  toBadge   BadgeTier
  trigger   String
  score     Decimal    @db.Decimal(6, 3)
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("badge_history")
}

model CommunityMessage {
  id            String    @id @default(cuid())
  userId        String
  content       String    @db.VarChar(500)
  replyToId     String?
  isPinned      Boolean   @default(false)
  isDeleted     Boolean   @default(false)
  deletedById   String?
  deletedAt     DateTime?
  editableUntil DateTime
  editedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user      User               @relation("MessageAuthor", fields: [userId], references: [id], onDelete: Restrict)
  deletedBy User?              @relation("MessageDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  replyTo   CommunityMessage?  @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   CommunityMessage[] @relation("Replies")

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([isPinned])
  @@map("community_messages")
}

// ─── Budget Guard ───────────────────────────────────────────────────────────────

model UserBudget {
  id        String     @id @default(cuid())
  userId    String
  type      BudgetType
  amount    Decimal    @db.Decimal(10, 2)
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  overrides BudgetOverride[]

  @@index([userId, type, isActive])
  @@map("user_budgets")
}

model BudgetOverride {
  id              String   @id @default(cuid())
  budgetId        String
  userId          String
  contributionId  String?
  attemptedAmount Decimal  @db.Decimal(10, 2)
  budgetAmount    Decimal  @db.Decimal(10, 2)
  overageAmount   Decimal  @db.Decimal(10, 2)
  reason          String?
  createdAt       DateTime @default(now())

  budget UserBudget @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("budget_overrides")
}

// ─── Admin Signature ────────────────────────────────────────────────────────────

model AdminSignature {
  id                  String   @id @default(cuid())
  adminId             String   @unique
  signatureUrl        String
  signatureHash       String
  displayName         String
  isActive            Boolean  @default(true)
  nextChangeAllowedAt DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  admin User @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@map("admin_signatures")
}

model AdminSignatureHistory {
  id            String   @id @default(cuid())
  adminId       String
  signatureUrl  String
  signatureHash String
  replacedAt    DateTime @default(now())
  replacedById  String

  admin User @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, replacedAt])
  @@map("admin_signature_history")
}

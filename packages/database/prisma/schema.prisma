generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // The app runs through Neon's pooled endpoint. Migrations cannot: a connection
  // pooler multiplexes statements across backends, so the advisory lock and
  // session state `prisma migrate` relies on do not survive. DIRECT_DATABASE_URL
  // points at the unpooled endpoint and is used for migrations only.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  /// Chose to leave. Not a deletion and not a punishment: history stays, future
  /// collections stop because every debit path collects only from ACTIVE.
  RESIGNED
}

enum RoleName {
  ADMIN
  MEMBER
}

enum AccountType {
  SAVINGS
  CHEQUE
  TRANSMISSION
}

enum MandateStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum ContributionStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  WAIVED
}

enum TransactionType {
  DEBIT_ORDER
  /// Member-initiated, but still submitted through the payment gateway.
  /// NOT an offline payment — see OFFLINE.
  MANUAL
  REVERSAL
  SCHEDULED
  /// Money that reached the group's bank account without touching the gateway
  /// at all — a cash deposit or an EFT the member made themselves, recorded
  /// after the fact by an admin who verified it against the bank statement.
  ///
  /// Deliberately distinct from MANUAL. MANUAL means "the member pressed pay
  /// and we submitted it to Netcash"; these rows never had a gateway, have no
  /// mandate, and carry no gatewayRef. Collapsing the two would make the
  /// transaction history unauditable — nobody could later tell which rows had
  /// ever been near a real payment provider.
  OFFLINE
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED

  /// Submitted, outcome unknown — a timeout or an unreachable gateway, where
  /// the bank may or may not have taken the money.
  ///
  /// Deliberately distinct from FAILED. A decline should be retried; an unknown
  /// outcome must be resolved before anything else is attempted, or the retry
  /// is how a member gets debited twice. Never counted as an inflow: money
  /// whose fate is unknown has not been received, so the fund understates
  /// rather than overstates until the truth is known.
  UNKNOWN
}

/// Whether this system and the payment gateway still agree about a mandate.
enum GatewaySyncState {
  /// As far as we know, the bank holds what we hold.
  IN_SYNC
  /// A change was written locally and the gateway has not confirmed it.
  PENDING
  /// The gateway refused or could not be reached. A person has to resolve it.
  FAILED
}

enum GoalType {
  MONTHLY
  YEARLY
  CUSTOM
}

/// What a member's standing commitment to a goal is currently doing.
enum GoalPlanStatus {
  ACTIVE
  /// Collections stopped but the plan is kept, so the member can resume it.
  /// Set when there is no usable mandate to charge, or after repeated failures.
  PAUSED
  /// The goal was met or its deadline passed. Terminal.
  COMPLETED
  /// The member stopped it themselves. Terminal.
  CANCELLED
}

enum GoalStatus {
  DRAFT
  ACTIVE
  ACHIEVED
  FAILED
  /// A proposal leadership reviewed and refused. Kept rather than deleted: the
  /// member who proposed it can see it was answered, and read why.
  REJECTED
}

enum NotifChannel {
  SMS
  EMAIL
  PUSH
  WHATSAPP
}

enum NotifStatus {
  QUEUED
  SENT
  FAILED
}

enum InboxCategory {
  BROADCAST
  SYSTEM
  PAYMENT
  GOAL
}

/// Which hat the recipient was wearing when a message was addressed to them.
///
/// Orthogonal to InboxCategory, and it has to be: a statement notice and an
/// operational alert are both SYSTEM, so the category cannot tell a member's
/// own business apart from the running of the Foundation.
///
/// It exists because one person holds both roles. Everything technical already
/// went only to ADMIN-role users, so no member was ever seeing it — but the
/// founder's own inbox merged the two streams, and the operational half is the
/// half a busy person scrolls past on the way to what actually concerns them.
enum InboxAudience {
  /// Addressed to the person as a member: their money, their goals, their
  /// statement. What every member sees, and the only kind most will ever have.
  MEMBER
  /// Addressed to the person as an administrator: alerts, job failures, things
  /// that need leadership to act. Only ever written to ADMIN-role users.
  ADMIN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum BadgeTier {
  AMATEUR
  SEMI_PRO
  PRO
  WORLD_CLASS
}

/// A mark that is *conferred*, never earned or computed.
///
/// Deliberately not a fifth BadgeTier. Tiers are recalculated from contribution
/// behaviour on every status change, so a value placed there would be
/// overwritten the next time that member paid — see docs/founder-badge-plan.md.
enum DistinctionKind {
  FOUNDER
}

enum BudgetType {
  MONTHLY
  YEARLY
  CUSTOM
}

// ─── Identity ─────────────────────────────────────────────────────────────────

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  phone             String     @unique
  firstName         String
  lastName          String
  idNumber          String?
  address           Json?
  password          String?
  emailVerified     DateTime?
  image             String?
  status            UserStatus @default(PENDING)
  popiaConsentAt    DateTime?
  loginAttempts     Int        @default(0)
  lockedUntil       DateTime?
  roleVersion       Int        @default(0)
  /// When this password was last set under the current strength policy.
  ///
  /// Null means the password predates the policy — set before registration
  /// began enforcing twelve characters. It is not "never changed": it is
  /// "changed, if at all, under a rule we no longer consider sufficient".
  ///
  /// Only read when REQUIRE_PASSWORD_POLICY_RESET is on. Off, this column is
  /// recorded and ignored, which is what makes turning the requirement on a
  /// decision rather than a deploy.
  passwordChangedAt DateTime?
  /// When this member chose to leave. Null for everyone still in the circle.
  resignedAt        DateTime?
  deletedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  roles                  UserRole[]
  accounts               Account[]
  sessions               Session[]
  bankAccounts           BankAccount[]
  mandates               PaymentMandate[]
  contributions          Contribution[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  auditLogs              AuditLog[]
  loginHistory           LoginHistory[]
  lockedGoals            Goal[]                   @relation("GoalLocker")
  createdGoals           Goal[]                   @relation("GoalCreator")
  documentedGoals        Goal[]                   @relation("GoalOutcomeRecorder")
  reviewedGoals          Goal[]                   @relation("GoalReviewer")
  recordedProgress       GoalProgress[]           @relation("ProgressRecorder")
  passwordResetTokens    PasswordResetToken[]
  emailVerifTokens       EmailVerificationToken[]
  invitesSent            Invitation[]             @relation("InvitesSent")
  dsrSubjectOf           DataSubjectRequest[]     @relation("DsrSubject")
  dsrHandled             DataSubjectRequest[]     @relation("DsrHandler")
  inviteAccepted         Invitation?              @relation("InviteAccepted")
  approvedMandates       PaymentMandate[]         @relation("MandateApprover")
  revokedInvitations     Invitation[]             @relation("InviteRevoker")
  badgeScore             BadgeScore?
  badgeHistory           BadgeHistory[]
  communityMessages      CommunityMessage[]       @relation("MessageAuthor")
  deletedCommunityMsgs   CommunityMessage[]       @relation("MessageDeleter")
  goalCheers             GoalCheer[]              @relation("GoalCheerUser")
  goalComments           GoalComment[]            @relation("GoalCommentAuthor")
  deletedGoalComments    GoalComment[]            @relation("GoalCommentDeleter")
  inboxMessages          InboxMessage[]           @relation("InboxRecipient")
  sentInboxMessages      InboxMessage[]           @relation("InboxSender")
  goalPledges            GoalPledge[]             @relation("GoalPledger")
  goalPayments           GoalPayment[]            @relation("GoalPaymentUser")
  goalPlans              GoalPlan[]               @relation("GoalPlanUser")
  budgets                UserBudget[]
  budgetOverrides        BudgetOverride[]
  signature              AdminSignature?
  signatureHistory       AdminSignatureHistory[]
  distinctions           MemberDistinction[]      @relation("DistinctionHolder")
  distinctionsGranted    MemberDistinction[]      @relation("DistinctionGranter")

  @@index([status])
  @@index([email, status])
  // Active-user filtering is served by the partial index `idx_users_active`
  // (status WHERE deletedAt IS NULL), created in raw SQL — Prisma's DSL cannot
  // express a partial index, so it is intentionally not declared here.
  @@map("users")
}

// ─── NextAuth required models ─────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Auth tokens ──────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model Role {
  id    String     @id @default(cuid())
  name  RoleName   @unique
  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ─── Banking ──────────────────────────────────────────────────────────────────

model BankAccount {
  id            String      @id @default(cuid())
  userId        String
  bankName      String
  accountNumber String
  accountType   AccountType
  branchCode    String
  isPrimary     Boolean     @default(false)
  verifiedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  mandates PaymentMandate[]

  // userId lookups are served by the composite below (leading column).
  @@index([userId, isPrimary])
  @@map("bank_accounts")
}

model PaymentMandate {
  id               String        @id @default(cuid())
  userId           String
  bankAccountId    String
  debitDay         Int
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("ZAR")
  status           MandateStatus @default(PENDING)
  netcashMandateId String?       @unique
  delayedUntil     DateTime?
  failureReason    String?

  /// Do this system and the bank still agree about this mandate?
  ///
  /// Orthogonal to `status`, which says what the mandate is for the member. An
  /// ACTIVE mandate can be out of step, and so can a CANCELLED one whose
  /// cancellation the gateway refused.
  ///
  /// Anything other than IN_SYNC means the debit run leaves this mandate alone:
  /// collecting the local amount when the bank authorised a different one gets
  /// the member a failed collection caused by our own bookkeeping.
  gatewaySync       GatewaySyncState @default(IN_SYNC)
  /// What went wrong, for the person who has to put it right.
  gatewaySyncReason String?
  /// When the two last disagreed — so a stale divergence is visible as stale.
  gatewaySyncAt     DateTime?
  approvedAt       DateTime?
  approvedById     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  bankAccount  BankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  approvedBy   User?         @relation("MandateApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  transactions Transaction[]

  // netcashMandateId uniqueness is enforced by a partial unique index
  // (WHERE netcashMandateId IS NOT NULL) in raw SQL. The @unique above keeps the
  // Prisma client aware of it; the DB shape is intentionally partial.
  // "At most one PENDING or ACTIVE mandate per user" is enforced by a partial
  // unique index (payment_mandates_one_active_per_user, userId WHERE status IN
  // ('PENDING','ACTIVE')) in raw SQL — the race-safe backstop for createMandate.
  // userId lookups are served by the [userId, status] composite (leading column).
  @@index([userId, status])
  @@index([bankAccountId])
  @@index([status])
  @@index([delayedUntil])
  @@map("payment_mandates")
}

// ─── Contributions & Transactions ─────────────────────────────────────────────

model Contribution {
  id          String             @id @default(cuid())
  userId      String
  periodMonth Int
  periodYear  Int
  amountDue   Decimal            @db.Decimal(12, 2)
  amountPaid  Decimal            @default(0) @db.Decimal(12, 2)
  currency    String             @default("ZAR")
  dueDate     DateTime
  status      ContributionStatus @default(PENDING)
  version     Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@unique([userId, periodMonth, periodYear])
  // userId lookups are served by the [userId, ...] composites below (leading column).
  @@index([userId, status])
  @@index([periodYear, periodMonth])
  @@index([status, dueDate])
  @@index([status, periodYear, periodMonth], map: "contributions_status_period_idx")
  @@index([userId, createdAt])
  @@map("contributions")
}

model Transaction {
  id               String            @id @default(cuid())
  contributionId   String
  /// Null only for OFFLINE transactions. Every gateway-borne payment is
  /// authorised by a mandate and must carry one; money handed over as cash or
  /// pushed by EFT genuinely has none, and inventing a placeholder mandate
  /// (which would need a placeholder bank account under it) would mean
  /// fabricating banking details for someone who never gave any.
  mandateId        String?
  amount           Decimal           @db.Decimal(12, 2)
  currency         String            @default("ZAR")
  type             TransactionType
  status           TransactionStatus @default(PENDING)
  gatewayRef       String?
  gatewayResponse  Json?
  idempotencyKey   String            @unique
  retryCount       Int               @default(0)
  failureReason    String?
  /// Why leadership reversed this transaction. Set on the REVERSAL row, never on
  /// the original — the original is evidence and is not edited. Null on rows
  /// written before the reason was required, and on everything that is not a
  /// reversal. Distinct from failureReason, which is the gateway refusing.
  reversalReason   String?
  reversalOfId     String?           @unique
  /// What the admin matched this OFFLINE payment against on the bank statement
  /// — an EFT reference, a deposit slip number. Required by the service layer
  /// for OFFLINE rows and null for everything else: a gateway payment already
  /// has gatewayRef, and this is the offline equivalent of that evidence.
  offlineReference String?
  /// The admin who recorded an OFFLINE payment. Unlike a gateway transaction,
  /// which no person asserts, an offline row is somebody's claim that money
  /// arrived — so the claim is attributable. Plain id, no relation, matching
  /// PaymentMandate.approvedById.
  recordedById     String?
  /// The proof of payment: a bank PDF, a screenshot, a photo of a deposit slip.
  /// Stored as a blob **pathname**, never a URL — see Goal.outcomeProofUrl for
  /// the same rule and blob-storage-privacy for why. The object is private and
  /// reachable only through a media route that checks this column claims it.
  ///
  /// Members already send these to the WhatsApp group; before this they were
  /// attached to nothing. It is what turns an offline row from one admin's
  /// assertion into something a third person can check against the bank.
  proofUrl         String?
  /// Who counted the money, when there is no document to attach.
  ///
  /// Cash handed over at a meeting has no proof of payment, and a hard file
  /// requirement would mean either the money goes unrecorded — the exact
  /// failure the offline path exists to prevent — or somebody attaches
  /// something irrelevant to satisfy the gate. So the absence is recorded
  /// instead: exactly one of proofUrl and proofWitness is required on an
  /// OFFLINE row, enforced by the service layer.
  ///
  /// Both are null on rows written before proof was required, and on every
  /// gateway transaction, which evidences itself through gatewayRef.
  proofWitness     String?
  /// When the money actually reached the account. For gateway rows this is set
  /// when the gateway settles; for OFFLINE rows the admin states it, and it is
  /// the date that matters — not when somebody got round to capturing it.
  processedAt      DateTime?
  createdAt        DateTime          @default(now())

  contribution Contribution    @relation(fields: [contributionId], references: [id], onDelete: Restrict)
  mandate      PaymentMandate? @relation(fields: [mandateId], references: [id], onDelete: Restrict)
  reversalOf   Transaction?    @relation("TransactionReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversal     Transaction?    @relation("TransactionReversal")

  // reversalOfId uniqueness (double-reversal guard) is enforced by a partial
  // unique index (WHERE reversalOfId IS NOT NULL) in raw SQL; @unique above keeps
  // the client aware. contributionId lookups are served by [contributionId, status].
  @@index([contributionId, status])
  @@index([mandateId])
  @@index([status, createdAt])
  @@index([gatewayRef])
  @@index([type])
  @@index([status, retryCount])
  /// The media routes look a proof up by pathname on every request, to check
  /// this column claims it before serving any bytes. Transactions are the
  /// fastest-growing table here, so that lookup gets an index rather than a
  /// scan.
  @@index([proofUrl])
  @@map("transactions")
}

/// Idempotency guard for inbound webhooks (e.g. Netcash). A redelivered event
/// with the same (source, eventKey) is acknowledged but never reprocessed.
model ProcessedWebhookEvent {
  id        String   @id @default(cuid())
  source    String
  eventKey  String
  createdAt DateTime @default(now())

  @@unique([source, eventKey])
  @@index([createdAt])
  @@map("processed_webhook_events")
}

enum LedgerAccount {
  POOL
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

/// Append-only, immutable ledger of every movement in/out of the collective
/// pool. The unique (refType, refId, direction) makes posting idempotent, so an
/// entry is recorded exactly once per source event no matter how many times the
/// hook or the reconciler runs. The pool balance is CREDIT sum minus DEBIT sum.
model LedgerEntry {
  id          String          @id @default(cuid())
  account     LedgerAccount   @default(POOL)
  direction   LedgerDirection
  amount      Decimal         @db.Decimal(12, 2)
  refType     String
  refId       String
  memberId    String?
  description String?
  createdAt   DateTime        @default(now())

  @@unique([refType, refId, direction])
  @@index([account, createdAt])
  @@index([memberId])
  @@map("ledger_entries")
}

// ─── Goals ────────────────────────────────────────────────────────────────────

model Goal {
  id                  String     @id @default(cuid())
  type                GoalType
  title               String
  description         String?
  targetAmount        Decimal    @db.Decimal(12, 2)
  currentAmount       Decimal    @default(0) @db.Decimal(12, 2)
  currency            String     @default("ZAR")
  deadline            DateTime
  status              GoalStatus @default(DRAFT)
  // The one common yearly fund every monthly contribution flows into. At most
  // one goal may be primary at a time — enforced by a partial unique index
  // (WHERE "isPrimary") created in raw SQL in the migration.
  isPrimary           Boolean    @default(false)
  version             Int        @default(0)
  lockedAt            DateTime?
  lockedById          String?
  /// Who proposed or created this goal. A member for a proposal, an admin for
  /// one leadership raised itself — the two paths are told apart by the roles
  /// of this user, not by a separate column.
  createdById         String?
  /// Step 6 of the Goal flow: what the money actually bought, shown back to the
  /// circle. The note is the account; the proof is a photo or receipt and is
  /// optional, so a missing receipt can never make a goal impossible to close.
  outcomeNote         String?
  outcomeProofUrl     String?
  outcomeRecordedAt   DateTime?
  outcomeRecordedById String?
  /// Why leadership refused a proposal. Set only alongside status REJECTED.
  rejectionReason     String?
  /// Which leader reviewed the proposal, and when. Empty on every goal created
  /// before proposals existed, which is the honest answer for them.
  reviewedById        String?
  reviewedAt          DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  locker          User?          @relation("GoalLocker", fields: [lockedById], references: [id], onDelete: SetNull)
  creator         User?          @relation("GoalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  outcomeRecorder User?          @relation("GoalOutcomeRecorder", fields: [outcomeRecordedById], references: [id], onDelete: SetNull)
  reviewer        User?          @relation("GoalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  progress        GoalProgress[]
  cheers          GoalCheer[]
  comments        GoalComment[]
  pledges         GoalPledge[]
  payments        GoalPayment[]
  plans           GoalPlan[]

  @@index([lockedById])
  @@index([createdById])
  @@index([outcomeRecordedById])
  @@index([reviewedById])
  @@index([status])
  @@index([status, deadline])
  @@map("goals")
}

// A member's directed extra payment toward a goal (primary or additional),
// collected via the payment gateway. Mirrors the transaction settlement model:
// SUCCESS money counts toward the goal; a unique idempotency key makes a retried
// submission a no-op.
model GoalPayment {
  id               String            @id @default(cuid())
  goalId           String
  userId           String
  amount           Decimal           @db.Decimal(12, 2)
  status           TransactionStatus @default(PENDING)
  idempotencyKey   String            @unique
  gatewayRef       String?
  createdAt        DateTime          @default(now())
  processedAt      DateTime?
  /// What an admin matched an offline payment against on the bank statement.
  /// Set only when a member gave toward a goal in cash or by EFT rather than
  /// through the gateway; null on every gateway payment, which has gatewayRef.
  /// Mirrors Transaction.offlineReference deliberately — the two are the same
  /// claim about two kinds of money, and one story is easier to trust.
  offlineReference String?
  /// The admin who recorded an offline payment. A gateway payment is asserted
  /// by nobody; an offline one is somebody's word that money arrived.
  recordedById     String?
  /// The proof of payment, as a private blob pathname. See
  /// Transaction.proofUrl — same rule, same media routes, same reason.
  proofUrl         String?
  /// Who counted the money, when cash means there is no document. Exactly one
  /// of this and proofUrl is required on an offline row.
  proofWitness     String?

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation("GoalPaymentUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([goalId, status])
  @@index([userId])
  /// Looked up by pathname on every media request, before any bytes are served.
  @@index([proofUrl])
  @@map("goal_payments")
}

/// A member's standing commitment to fund one goal every month.
///
/// The monthly contribution is collected by the member's debit order; this is
/// the same idea aimed at a single goal, for members who would rather commit up
/// front than remember to pay. Collections are charged against the member's
/// existing mandate — there is deliberately no mandate per plan, because a
/// member may hold only one active mandate at a time.
///
/// A plan is an instruction, not money. Every rand it moves is still a
/// GoalPayment, so the goal's derived total and its reversal behaviour are
/// unchanged by this model existing.
model GoalPlan {
  id                  String         @id @default(cuid())
  userId              String
  goalId              String
  /// What to collect each month. Suggested from the goal's remaining amount
  /// over the months left, then free for the member to change.
  amount              Decimal        @db.Decimal(12, 2)
  /// Day of the month to collect, 1–31. A day past the end of a short month is
  /// clamped to that month's last day rather than skipped, so a plan set to the
  /// 31st still collects in February.
  debitDay            Int
  status              GoalPlanStatus @default(ACTIVE)
  /// The last period this plan collected for, as YYYY-MM. The collection job
  /// reads it to know whether this month is already done, and the same value
  /// forms the idempotency key — so a retried job cannot charge twice.
  lastCollectedPeriod String?
  /// Consecutive months whose collection never succeeded. Reset by a success.
  failedRuns          Int            @default(0)
  version             Int            @default(0)

  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  /// Why the plan stopped — goal met, deadline passed, member cancelled, no
  /// usable mandate. Kept so a member can be told what happened to it.
  endedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation("GoalPlanUser", fields: [userId], references: [id], onDelete: Cascade)

  /// One live plan per member per goal. Enforced as a partial unique index in
  /// raw SQL (WHERE status = 'ACTIVE'), because a member who cancels and later
  /// rejoins the same goal must be able to.
  @@index([userId, status])
  @@index([status, debitDay])
  @@map("goal_plans")
}

model GoalCheer {
  id        String   @id @default(cuid())
  goalId    String
  userId    String
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation("GoalCheerUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([goalId, userId])
  @@index([goalId])
  @@map("goal_cheers")
}

model GoalComment {
  id          String    @id @default(cuid())
  goalId      String
  userId      String
  content     String    @db.VarChar(500)
  isDeleted   Boolean   @default(false)
  deletedById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  goal      Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user      User  @relation("GoalCommentAuthor", fields: [userId], references: [id], onDelete: Cascade)
  deletedBy User? @relation("GoalCommentDeleter", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([goalId, createdAt])
  @@map("goal_comments")
}

model GoalPledge {
  id        String   @id @default(cuid())
  goalId    String
  userId    String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation("GoalPledger", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([goalId, userId])
  @@index([goalId])
  @@map("goal_pledges")
}

model GoalProgress {
  id           String   @id @default(cuid())
  goalId       String
  amount       Decimal  @db.Decimal(12, 2)
  note         String?
  recordedById String?
  recordedAt   DateTime @default(now())

  goal       Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  recordedBy User? @relation("ProgressRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  // goalId lookups are served by the [goalId, recordedAt] composite (leading column).
  @@index([goalId, recordedAt])
  @@map("goal_progress")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model NotificationTemplate {
  id      String       @id @default(cuid())
  slug    String       @unique
  channel NotifChannel
  subject String?
  body    String

  notifications Notification[]

  @@index([channel])
  @@map("notification_templates")
}

model Notification {
  id           String       @id @default(cuid())
  userId       String
  templateId   String
  channel      NotifChannel
  status       NotifStatus  @default(QUEUED)
  payload      Json
  retryCount   Int          @default(0)
  errorMessage String?
  externalRef  String?
  sentAt       DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  template NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([templateId])
  // No index on [status] alone: it is a strict prefix of [status, createdAt],
  // which serves the same queries. None on [channel] either — nothing filters
  // by channel on its own, and with four possible values an index on it would
  // never be chosen. Both were measured as dead and dropped; every plan on this
  // table was identical afterwards, and inserts got ~8% cheaper.
  @@index([status, createdAt])
  // Serves the stalled-'in-flight' recovery scan: WHERE status/errorMessage +
  // updatedAt < cutoff. See notification.service.recoverStalledNotifications.
  @@index([status, updatedAt])
  // externalRef lookups are served by a partial index (WHERE externalRef IS NOT
  // NULL) in raw SQL — lookups are always by a concrete provider ref, so the
  // partial covers them without indexing the many NULL rows.
  @@map("notifications")
}

/// Member-facing in-app messages (admin broadcasts and key system events).
/// Distinct from Notification, which is an SMS/email delivery log.
model InboxMessage {
  id          String        @id @default(cuid())
  userId      String
  title       String
  body        String        @db.Text
  category    InboxCategory @default(BROADCAST)
  /// Defaults to MEMBER so that anything written without an opinion lands where
  /// a member would look. Only `notifyAdmins` sets ADMIN.
  audience    InboxAudience @default(MEMBER)
  readAt      DateTime?
  createdById String?
  createdAt   DateTime      @default(now())

  user      User  @relation("InboxRecipient", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("InboxSender", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  /// The inbox is read one audience at a time, with an unread count per tab.
  @@index([userId, audience, readAt])
  @@map("inbox_messages")
}

model NotificationPreference {
  id       String  @id @default(cuid())
  userId   String  @unique
  sms      Boolean @default(true)
  email    Boolean @default(true)
  push     Boolean @default(true)
  whatsapp Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ─── Audit ────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  payload   Json
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Invitations ─────────────────────────────────────────────────────────────

model Invitation {
  id            String           @id @default(cuid())
  codeHash      String           @unique
  codePrefix    String
  firstName     String
  lastName      String
  email         String
  phone         String
  /// The invitee's SA ID, encrypted, set by the admin who knows them.
  ///
  /// Leadership vouches for who this person is; the member confirms they are
  /// the one holding the invitation. Before this the member typed their own ID
  /// at registration and it was optional — so the Foundation trusted a
  /// self-reported identity for the thing that ties a bank account to a person,
  /// and nobody could correct it afterwards.
  idNumber      String
  /// How the inviting admin knows this person. Free text, optional.
  ///
  /// `invitedById` already records *who* invited them. This records *why* they
  /// could vouch, which is the part that cannot be derived from anything else.
  vouchedFor    String?
  minimumAmount Decimal          @db.Decimal(12, 2)
  currency      String           @default("ZAR")
  status        InvitationStatus @default(PENDING)
  invitedById   String
  acceptedById  String?          @unique
  revokedById   String?
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime         @default(now())

  invitedBy  User  @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy User? @relation("InviteAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedBy  User? @relation("InviteRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  // "One PENDING invite per contact" is enforced by partial unique indexes
  // (email/phone WHERE status = 'PENDING') in raw SQL — this matches the service,
  // which only blocks a pending duplicate and allows re-inviting an expired or
  // revoked contact. There is deliberately NO full unique on email/phone.
  @@index([invitedById])
  @@index([email])
  @@index([status])
  @@index([status, expiresAt])
  @@map("invitations")
}

// ─── Login history ────────────────────────────────────────────────────────────

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  ipAddress String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, success])
  @@map("login_history")
}

// ─── System configuration ─────────────────────────────────────────────────────

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("system_config")
}

// ─── Scheduled job liveness ───────────────────────────────────────────────────

/// One row per scheduled job, rewritten at the end of every completed run.
///
/// Every other alert in this system is raised *by* a job that ran. A job that
/// never fires at all — an Inngest app that failed to sync, a function that was
/// disabled, a deploy that dropped a registration — raises nothing, because the
/// thing that would have spoken is the thing that is missing. This table is the
/// evidence that it ran; `job-heartbeat-check` is what reads it.
///
/// `jobId` is the Inngest function id, which is what makes the row findable
/// from a dashboard. There is deliberately no expected-interval column: that
/// belongs beside the cron expression in code, not in a second place it can
/// drift from.
model JobHeartbeat {
  jobId     String   @id
  lastRunAt DateTime
  updatedAt DateTime @updatedAt

  @@map("job_heartbeats")
}

// ─── Badges & Community ────────────────────────────────────────────────────────

model BadgeScore {
  id                String    @id @default(cuid())
  userId            String    @unique
  currentBadge      BadgeTier @default(AMATEUR)
  overallScore      Decimal   @default(0) @db.Decimal(6, 3)
  consistencyScore  Decimal   @default(0) @db.Decimal(6, 3)
  timelinessScore   Decimal   @default(0) @db.Decimal(6, 3)
  generosityScore   Decimal   @default(0) @db.Decimal(6, 3)
  streakBonus       Decimal   @default(0) @db.Decimal(6, 3)
  progressToNext    Decimal   @default(0) @db.Decimal(6, 3)
  currentStreak     Int       @default(0)
  longestStreak     Int       @default(0)
  totalPaidMonths   Int       @default(0)
  totalOnTimeMonths Int       @default(0)
  totalOverdue      Int       @default(0)
  overdueInLast6    Int       @default(0)
  monthsActive      Int       @default(0)
  avgContribution   Decimal   @default(0) @db.Decimal(10, 2)
  graceUntil        DateTime?
  lastCalculatedAt  DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([currentBadge])
  @@index([overallScore])
  @@map("badge_scores")
}

model BadgeHistory {
  id        String     @id @default(cuid())
  userId    String
  fromBadge BadgeTier?
  toBadge   BadgeTier
  trigger   String
  score     Decimal    @db.Decimal(6, 3)
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("badge_history")
}

/// A permanent, granted distinction — today only FOUNDER.
///
/// Separate from BadgeScore by design: that record is derived and rewritten by
/// the recalculation job, and this one is a decision a person made and must
/// outlive every recalculation. Nothing in badge.service.ts reads or writes it.
model MemberDistinction {
  id          String          @id @default(cuid())
  userId      String
  kind        DistinctionKind
  /// Who granted it. With a single admin who is himself a founder, self-grants
  /// are expected — storing this is what makes one visible as such.
  grantedById String
  grantedAt   DateTime        @default(now())
  note        String?

  user      User @relation("DistinctionHolder", fields: [userId], references: [id], onDelete: Cascade)
  /// Deliberately no cascade: a granted badge must not disappear because the
  /// person who granted it was removed.
  grantedBy User @relation("DistinctionGranter", fields: [grantedById], references: [id])

  /// A double grant is impossible in the database, not merely in the service.
  @@unique([userId, kind])
  @@index([kind])
  @@map("member_distinctions")
}

model CommunityMessage {
  id            String    @id @default(cuid())
  userId        String
  content       String    @db.VarChar(500)
  replyToId     String?
  isPinned      Boolean   @default(false)
  isDeleted     Boolean   @default(false)
  deletedById   String?
  deletedAt     DateTime?
  editableUntil DateTime
  editedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user      User               @relation("MessageAuthor", fields: [userId], references: [id], onDelete: Restrict)
  deletedBy User?              @relation("MessageDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  replyTo   CommunityMessage?  @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   CommunityMessage[] @relation("Replies")

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([isPinned])
  // Two PARTIAL indexes serve the board itself and live in raw SQL, because
  // @@index cannot express a WHERE clause:
  //   community_messages_board_idx    (isPinned DESC, createdAt DESC)
  //                                   WHERE isDeleted = false AND replyToId IS NULL
  //   community_messages_replies_idx  (replyToId, createdAt) WHERE isDeleted = false
  // A plain composite on the same columns was measured and the planner ignored
  // it; restricting each index to the rows its query wants is what made the
  // board page 37x faster. See the 20260726140000 migration.
  @@map("community_messages")
}


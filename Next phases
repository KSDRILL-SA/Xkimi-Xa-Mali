## Step 2 — `withApiHandler` Wrapper
**Time: 1 hour | Affects: all 51 API routes**

This is the most impactful remaining item. Currently every route has its own `try/catch` with varying quality. Some swallow errors silently. Some return inconsistent shapes. This centralises all of that.

**Create the file:**

```typescript
// apps/web/lib/api-handler.ts

import { NextRequest, NextResponse } from 'next/server'
import { randomUUID } from 'crypto'
import { isAppError } from '@/lib/errors'
import { logger } from '@/lib/logger'
import * as Sentry from '@sentry/nextjs'

type RouteContext = { params: Record<string, string> }
type Handler = (req: NextRequest, ctx: RouteContext) => Promise<NextResponse>

export function withApiHandler(handler: Handler): Handler {
  return async (req: NextRequest, ctx: RouteContext) => {
    const traceId = req.headers.get('x-trace-id') ?? randomUUID()

    try {
      const response = await handler(req, ctx)
      response.headers.set('x-trace-id', traceId)
      return response
    } catch (err) {
      if (isAppError(err)) {
        logger.warn('Application error', {
          code: err.code,
          message: err.message,
          status: err.status,
          traceId,
          path: req.nextUrl.pathname,
        })
        return NextResponse.json(
          { error: { code: err.code, message: err.message, traceId } },
          { status: err.status, headers: { 'x-trace-id': traceId } },
        )
      }

      // Unhandled — this should never reach production
      Sentry.captureException(err, {
        extra: { traceId, path: req.nextUrl.pathname, method: req.method },
      })
      logger.error('Unhandled API error', {
        err,
        traceId,
        path: req.nextUrl.pathname,
        method: req.method,
      })

      return NextResponse.json(
        { error: { code: 'SYS_500', message: 'An unexpected error occurred', traceId } },
        { status: 500, headers: { 'x-trace-id': traceId } },
      )
    }
  }
}
```

**Apply to every route — the before/after pattern:**

```typescript
// BEFORE (every route currently looks like this)
export async function POST(req: NextRequest) {
  try {
    const session = await auth()
    if (!session) return apiError('SYS_002', 'Unauthorised', 401)
    const body = await req.json()
    const result = await someService(body)
    return apiSuccess(result)
  } catch (err) {
    if (err instanceof SomeError) return apiError(...)
    return apiError('SYS_500', 'Something went wrong', 500)
  }
}

// AFTER — throw freely, wrapper handles everything
export const POST = withApiHandler(async (req) => {
  const session = await auth()
  if (!session) throw new UnauthorizedError()
  const body = await req.json()
  const result = await someService(body)   // throws AppError if invalid
  return apiSuccess(result)
})
```


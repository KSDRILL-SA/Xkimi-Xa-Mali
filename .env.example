# ─── Deployment identity ─────────────────────────────────────────────────────
# Which deployment this is. "production" turns on the strict config rules: the
# app then REFUSES TO BUILD unless every credential below that it needs to work
# is present, instead of starting up and failing quietly later.
#
# Leave it blank on Vercel — VERCEL_ENV is set automatically and is used instead.
# Set it to "development" locally and "ci" in CI, so a compile check does not
# demand a dozen production secrets. Anything other than "production" is
# treated as not live.
DEPLOY_ENV=development

# ─── Edge / client-IP trust ──────────────────────────────────────────────────
# Which proxy sits in front of this deployment, and therefore which forwarded-IP
# header can be believed. Rate limiting keys on the client IP, so believing a
# header that nothing in front of the app overwrites lets a caller mint a fresh
# bucket per request and brute-force protection stops working.
#
#   vercel      (default) trust x-vercel-forwarded-for / x-forwarded-for
#   cloudflare  trust cf-connecting-ip — ONLY if Cloudflare is genuinely in front
#   none        trust nothing; unattributable traffic shares one bucket
#
# Change this if you ever put a CDN or WAF in front, or the app will keep
# trusting a header nobody is setting any more.
TRUSTED_PROXY=vercel

# ─── Database ────────────────────────────────────────────────────────────────
# Local: postgresql://xxm:xxm_local_password@localhost:5432/xxm_dev
# Production (Neon): the POOLED connection string — the one with "-pooler" in the
# host. This is what the app runs on.
DATABASE_URL=

# The UNPOOLED connection string, used for migrations only (prisma migrate,
# prisma validate). A pooler multiplexes statements across backends, so the
# advisory lock and session state migrations depend on do not survive it.
# Locally there is no pooler, so this is the same value as DATABASE_URL.
DIRECT_DATABASE_URL=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# NextAuth v5 standard name (preferred). If AUTH_SECRET is set it takes priority;
# otherwise NEXTAUTH_SECRET is used as the fallback.
# Generate: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── Encryption ───────────────────────────────────────────────────────────────
# Protects stored bank account and ID numbers.
# Generate: openssl rand -hex 32   (must be exactly 32 bytes hex = 64 chars)
ENCRYPTION_KEY=

# The two below are only needed while rotating the key. Leave them unset
# otherwise — an unconfigured deployment behaves exactly as it always has.
#
# Replacing ENCRYPTION_KEY on its own makes every stored bank and ID number
# unreadable. Rotating it is a three-step procedure: docs/runbook.md,
# "Rotating the encryption key".
#
# Stamped into each value written from now on, so a row can be attributed to a
# key. Defaults to 1. Increment it as part of a rotation.
# ENCRYPTION_KEY_ID=2
#
# Retired keys, "id:hex" comma separated. Used for reading only, never for a new
# write. A key stays here until `npm run secrets:reencrypt` reports zero rows
# left under it.
# ENCRYPTION_PREVIOUS_KEYS=1:<the previous 64-hex key>

# ─── Operational alerting ─────────────────────────────────────────────────────
# A standing address for CRITICAL alerts (debit run incomplete, ledger drift, a
# job that died), independent of any user account.
#
# Every other alert channel routes through an ACTIVE admin's user row and the
# notification queue. This system runs with a single admin, so that chain has no
# spare link — a suspended account, an unreachable phone, or a dead flush worker
# and nobody is told. This address needs no account and is sent directly.
#
# Optional. Unset, alerting behaves as it did before this existed. Set it on any
# live deployment. A shared operations mailbox is the intended use.
ALERT_FALLBACK_EMAIL=

# ─── Netcash (SA Debit Orders) ────────────────────────────────────────────────
# Optional for local development. REQUIRED in a production build using the real
# gateway — it refuses to start without both. Missing the service key means no
# debit is ever submitted; missing the webhook secret is worse, because the
# debits still collect but every callback fails its signature check, so nothing
# is recorded and the ledger silently disagrees with the bank.
NETCASH_SERVICE_KEY=
NETCASH_WEBHOOK_SECRET=
# Sandbox: https://ws.netcash.co.za/NSWSSX/NetcashTest.asmx
# Production: https://ws.netcash.co.za/NSWSSX/Netcash.asmx
# Set to "mock" to run against a stand-in gateway that moves no money — for local
# development and end-to-end tests. Any other value, or unset, uses Netcash.
# The LIVE deployment REFUSES TO START with this set to mock, because a mock
# gateway would report uncollected debits as settled. Staging may use it.
PAYMENT_GATEWAY=

# Required on the live deployment. It used to default to the TEST endpoint, so
# forgetting it meant every debit went to a gateway that moves no money.
NETCASH_API_URL=

# Netcash's webhook source IPs, comma separated. Leave blank to use the built-in
# list in apps/web/lib/netcash.ts. Set it only if Netcash tells you the range has
# changed — wrong values reject every callback, and the debits still collect.
NETCASH_WEBHOOK_IPS=

# ─── BulkSMS (SMS Provider) ───────────────────────────────────────────────────
BULKSMS_USERNAME=
BULKSMS_PASSWORD=

# ─── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
# The address members see mail arrive FROM. It must be on a domain verified in
# Resend, so it cannot be a gmail.com address — use noreply@<your-domain> once
# the domain is registered. Getting this wrong does not fail the build; Resend
# rejects the send at run time and every notification silently stops.
RESEND_FROM_EMAIL=

# ─── Inngest (Job Engine) ─────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Upstash Redis ────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Vercel Blob (File Storage) ───────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ─── Monitoring ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
# Server-side DSN (optional; falls back to NEXT_PUBLIC_SENTRY_DSN if unset)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── Security tunables (optional — sensible defaults applied if unset) ─────────
# Failed logins before an account is temporarily locked (3–20, default 5)
MAX_LOGIN_ATTEMPTS=5
# Minutes an account stays locked after too many failures (5–1440, default 15)
LOCKOUT_DURATION_MINUTES=15

# ─── Seed (used by prisma/seed.ts only — never in production app) ─────────────
FOUNDER_EMAIL=
FOUNDER_PHONE=
FOUNDER_PASSWORD=

# ─── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_MANUAL_PAYMENTS=true
ENABLE_GOAL_LOCKING=true

# ─── Support ─────────────────────────────────────────────────────────────────
# Shown to members on the support page as a mailto: link.
#
# The Foundation's operational mailbox is xkimxamali@gmail.com. It is a
# *receiving* address — safe here, safe on the public site, and NOT usable as
# RESEND_FROM_EMAIL (see the Resend section: sending needs a domain you can
# verify, and nobody can verify gmail.com).
SUPPORT_EMAIL=

# ─── WhatsApp ────────────────────────────────────────────────────────────────
WHATSAPP_GROUP_LINK=
WHATSAPP_GROUP_NAME=Xkimm Xa Mali Foundation
# Admin WhatsApp number in international format without + (e.g. 27821234567)
ADMIN_WHATSAPP_NUMBER=

# ─── Website app (@xxm/website) — copy to apps/website/.env.local ───────────
# Public URL of this marketing website (dev: http://localhost:3001)
NEXT_PUBLIC_SITE_URL=
# URL of the web app — member portal + sign-in (dev: http://localhost:3000)
NEXT_PUBLIC_APP_URL=
# URL of the admin dashboard app (dev: http://localhost:3002)
NEXT_PUBLIC_ADMIN_URL=
# Must match WHATSAPP_GROUP_LINK above — exposed to the browser for the website
NEXT_PUBLIC_WHATSAPP_GROUP_LINK=
# Must match ADMIN_WHATSAPP_NUMBER above — exposed to the browser for the website
NEXT_PUBLIC_ADMIN_WHATSAPP_NUMBER=
# Must match SUPPORT_EMAIL above — printed in the marketing site footer, so that
# somebody who is not in the WhatsApp group yet still has a way to reach us.
NEXT_PUBLIC_SUPPORT_EMAIL=

# ─── Admin app (@xxm/admin) — copy to apps/admin/.env.local ─────────────────
# Same DATABASE_URL as web app.
# AUTH_SECRET must match the value set in the web app (same JWT signing key).
# Generate: openssl rand -base64 32
AUTH_SECRET=
# Admin app public URL (dev: http://localhost:3002)
NEXTAUTH_URL=http://localhost:3002

# ─── Admin ↔ Web integration (set in apps/web AND apps/admin .env.local) ──────
# Internal URL of the web app — used by admin for server-to-server API calls.
# In production set to the private network address (e.g. http://web.internal:3000).
WEB_INTERNAL_URL=http://localhost:3000
# Shared secret for trusted admin→web server calls — bypasses session check.
# MUST be set in both apps to the same value.
# Generate: openssl rand -base64 32
ADMIN_API_SECRET=

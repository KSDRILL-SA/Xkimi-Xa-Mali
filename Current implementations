// Core check function — called before every manual payment
async function checkBudget(userId, amount, type = 'MONTHLY'): Promise<BudgetCheckResult> {
  const budget = await budgetRepo.findActiveByType(userId, type)
  if (!budget) return { status: 'NO_BUDGET' }        // no budget set, allow freely

  const alreadyContributed = await contributionRepo.sumPaidInPeriod(userId, budget)
  const remaining = budget.amount - alreadyContributed
  const wouldTotal = alreadyContributed + amount

  if (wouldTotal <= budget.amount) {
    return { status: 'WITHIN_BUDGET', remaining, wouldTotal }
  }

  return {
    status: 'OVER_BUDGET',
    budget: budget.amount,
    alreadyContributed,
    remaining,
    wouldTotal,
    overage: wouldTotal - budget.amount,
  }
}


# ─── Database ────────────────────────────────────────────────────────────────
# Local: postgresql://xxm:xxm_local_password@localhost:5432/xxm_dev
DATABASE_URL=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── Encryption ───────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32   (must be exactly 32 bytes hex = 64 chars)
ENCRYPTION_KEY=

# ─── Netcash (SA Debit Orders) ────────────────────────────────────────────────
NETCASH_SERVICE_KEY=
NETCASH_WEBHOOK_SECRET=
# Sandbox: https://ws.netcash.co.za/NSWSSX/NetcashTest.asmx
# Production: https://ws.netcash.co.za/NSWSSX/Netcash.asmx
NETCASH_API_URL=https://ws.netcash.co.za/NSWSSX/NetcashTest.asmx

# ─── BulkSMS (SMS Provider) ───────────────────────────────────────────────────
BULKSMS_USERNAME=
BULKSMS_PASSWORD=

# ─── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@xkimmxamali.co.za

# ─── Inngest (Job Engine) ─────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Upstash Redis ────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Vercel Blob (File Storage) ───────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ─── Monitoring ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── Seed (used by prisma/seed.ts only — never in production app) ─────────────
FOUNDER_EMAIL=
FOUNDER_PHONE=
FOUNDER_PASSWORD=

# ─── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_MANUAL_PAYMENTS=true
ENABLE_GOAL_LOCKING=true

# ─── WhatsApp ────────────────────────────────────────────────────────────────
WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/YOUR_GROUP_CODE
WHATSAPP_GROUP_NAME=Xkimm Xa Mali
